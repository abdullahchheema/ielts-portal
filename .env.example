# Supabase Postgres. DATABASE_URL = Transaction pooler (port 6543, add ?pgbouncer=true).
# DIRECT_URL = Session pooler (port 5432) — used for migrations.
DATABASE_URL=
DIRECT_URL=
# Redis (optional in dev; e.g. Upstash rediss://...). Unset = in-memory rate limiting.
REDIS_URL=
# S3-compatible storage (Cloudflare R2 / Supabase Storage / AWS S3).
# Leave blank in dev to store files in a private local folder (.storage/).
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Email (optional in dev; unset = emails are logged to the console)
RESEND_API_KEY=
MAIL_FROM=
# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Two-factor sign-in (TOTP) for admin accounts. Temporarily OFF while developing; the code is kept, so set true to bring it back.
# If unset it defaults to true in production and false everywhere else.
TWO_FACTOR_ENABLED=false
# Set true on instances that should NOT run the background sweepers (timed attempts, reminders, expiry)
DISABLE_SWEEPER=false
# Continue with Google (optional). Both must be set for the button to appear.
# Authorized redirect URI in Google Cloud: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Seed super admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
