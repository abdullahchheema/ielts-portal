  decidedAt     DateTime? @map("decided_at")
  decisionNote  String?   @map("decision_note")
  createdAt     DateTime  @default(now()) @map("created_at")

  session     LiveSession    @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedBy User           @relation("CorrectionRequester", fields: [requestedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decidedBy   User?          @relation("CorrectionDecider", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("attendance_corrections")
}

model AttendanceWarning {
