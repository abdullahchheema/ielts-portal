  studentId   String    @map("student_id") @db.Uuid
  assigneeId  String    @map("assignee_id") @db.Uuid
  dueAt       DateTime? @map("due_at")
  status      String    @default("OPEN")
  note        String
  source      String    @default("MANUAL")
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee  User           @relation("FollowUpAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy User?          @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assigneeId, status], map: "follow_up_tasks_assignee_idx")
