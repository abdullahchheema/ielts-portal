  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  author User @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([targetType, targetId, createdAt], map: "internal_notes_target_idx")
  @@map("internal_notes")
}

model KnowledgeArticle {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  body      String
  audience  String   @default("STAFF")
  status    String   @default("DRAFT")
  updatedById String? @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  updatedBy User? @relation("KnowledgeEditor", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("knowledge_articles")
}

model AiConversation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  mode      String    @default("GENERAL")
  title     String    @default("New chat")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  user     User        @relation("TutorOwner", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages AiMessage[]

  @@index([userId, updatedAt], map: "ai_conversations_user_idx")
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String
  content        String
  sources        Json?
  aiRequestId    String?  @map("ai_request_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aiRequest    AiRequest?     @relation(fields: [aiRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([conversationId, createdAt], map: "ai_messages_conversation_idx")
  @@map("ai_messages")
}

// ───────── Finance and security ─────────
model PaymentRiskFlag {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId  String    @map("payment_id") @db.Uuid
  proofId    String    @map("proof_id") @db.Uuid
  rule       String
  level      String
  reason     String
  status     String    @default("OPEN")
  reviewedById String? @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at")
  reviewNote String?   @map("review_note")
  createdAt  DateTime  @default(now()) @map("created_at")

  payment    Payment      @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proof      PaymentProof @relation(fields: [proofId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy User?        @relation("RiskReviewer", fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([proofId, rule], map: "payment_risk_flags_unique")
  @@map("payment_risk_flags")
}

model StatementImport {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  method       String
  rowCount     Int      @map("row_count")
  uploadedById String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy User            @relation("StatementUploader", fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines      StatementLine[]

  @@map("statement_imports")
}

model StatementLine {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId    String   @map("import_id") @db.Uuid
  method      String
  reference   String
  amount      Decimal  @db.Decimal(12, 2)
  txnDate     DateTime @map("txn_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  statementImport StatementImport       @relation(fields: [importId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reconciliations PaymentReconciliation[]

  @@map("statement_lines")
}

model PaymentReconciliation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proofId         String    @unique @map("proof_id") @db.Uuid
  status          String
  reasons         String[]  @default([])
  statementLineId String?   @map("statement_line_id") @db.Uuid
  resolution      String?
  resolutionNote  String?   @map("resolution_note")
  resolvedById    String?   @map("resolved_by") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  proof         PaymentProof   @relation(fields: [proofId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statementLine StatementLine? @relation(fields: [statementLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedBy    User?          @relation("ReconciliationResolver", fields: [resolvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("payment_reconciliations")
}

model CertificateRevocation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificateId String   @unique @map("certificate_id") @db.Uuid
  reason        String
  revokedById   String   @map("revoked_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revokedBy   User        @relation("CertificateRevoker", fields: [revokedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("certificate_revocations")
}
