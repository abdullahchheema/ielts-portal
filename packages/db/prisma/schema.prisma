  lastActivityLabel String?   @map("last_activity_label")
  reasons           String[]  @default([])
  computedAt        DateTime  @default(now()) @map("computed_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

