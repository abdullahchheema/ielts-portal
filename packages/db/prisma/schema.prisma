// WARNING: this schema is a SUBSET of the real database.
//
// The migrations in ./migrations are the source of truth. They also create objects Prisma
// cannot express and will not see here: ~25 CHECK constraints, 3 functions, 10 triggers
// (audit_logs / payment_events / submission_feedback / rubric_scores are immutable at the
// engine level), 7 partial & expression unique indexes, and RLS on every table.
//
// Therefore: NEVER run `prisma migrate dev`. There is no shadow database configured, so it
// would try to create and drop a database on the production instance, and it would generate
// DROP statements for anything it cannot see. Use `npm run drift` to check, hand-write the
// migration SQL, then `npm run migrate` (prisma migrate deploy).
//
// Partial/expression indexes that exist only in SQL — do not let a migration drop these:
//   vocabulary_items_word_unique (lower(word)), grammar_observations_one_per_excerpt (partial),
//   payment_proofs_file_sha256_idx (partial), statement_lines_ref_idx (expression),
//   enrollments_one_live_per_batch, seat_reservations_one_open_per_student_batch,
//   payment_proofs_approved_txn_unique, assessment_attempts_one_in_progress,
//   submissions_one_open, notifications_user_dedupe_key, courses_single_live
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────── Enums ─────────
enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
  DEACTIVATED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ContentType {
  VIDEO
  PDF
  TEXT
  AUDIO
  QUIZ
  ASSIGNMENT
  LISTENING_TEST
  READING_TEST
  WRITING_TASK
  SPEAKING_TASK
  LIVE_SESSION
  EXTERNAL_LINK
  DOWNLOAD
  MOCK_TEST
}

enum ReleaseType {
  IMMEDIATE
  BATCH_DATE
  RELATIVE
  PREREQUISITE
  SCORE_BASED
  MANUAL
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BatchStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum DeliveryMode {
  ONLINE
  ONSITE
  HYBRID
}

enum MentorRole {
  MAIN
  WRITING
  SPEAKING
}

enum EnrollmentStatus {
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
  CANCELLED
  REFUNDED
  SUSPENDED
  REJECTED
}

enum EnrollmentSource {
  ONLINE_PURCHASE
  ADMIN
  SCHOLARSHIP
  CORPORATE
  PROMOTION
  MIGRATION
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  LOCKED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PENDING_REVIEW
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK
}

enum PaymentProvider {
  BANK_TRANSFER
  MANUAL
}

enum ProofStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum AssessmentType {
  PRACTICE
  QUIZ
  LISTENING
  READING
  WRITING
  SPEAKING
  MOCK
  DIAGNOSTIC
  FINAL
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_GRADED
  PENDING_MANUAL_GRADING
  GRADED
  EXPIRED
  INVALIDATED
}

enum SessionAttendance {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_STUDENT
  RESOLVED
  CLOSED
  ASSIGNED
}

enum TicketCategory {
  ACCOUNT
  PAYMENT
  COURSE
  TECHNICAL
  CLASS
  ASSESSMENT
  MENTOR
  OTHER
  ENROLLMENT
  CERTIFICATE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}


// ───────── Identity ─────────
model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  phone           String?
  passwordHash    String        @map("password_hash")
  status          AccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?     @map("email_verified_at")
  phoneVerifiedAt DateTime?     @map("phone_verified_at")
  lastLoginAt     DateTime?     @map("last_login_at")
  failedLogins    Int           @default(0) @map("failed_logins")
  lockedUntil     DateTime?     @map("locked_until")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  student       StudentProfile?
  mentor        MentorProfile?
  roles         UserRole[]
  refreshTokens RefreshToken[]
  emailTokens   EmailVerificationToken[]
  resetTokens   PasswordResetToken[]
  mfa           MfaSecret?
  notifications Notification[]
  tickets       SupportTicket[]
  auditLogs     AuditLog[]
  questionSetsCreated  QuestionSet[]          @relation("QuestionSetCreator")
  couponsCreated       Coupon[]               @relation("CouponCreator")
  referralAttribution  Referral?              @relation("ReferredUser")
  referralsDecided     Referral[]             @relation("ReferralDecider")
  creditEntriesCreated AccountCreditLedger[]  @relation("CreditCreator")
  internalNotes        InternalNote[]         @relation("NoteAuthor")
  knowledgeEdited      KnowledgeArticle[]     @relation("KnowledgeEditor")
  tutorConversations   AiConversation[]      @relation("TutorOwner")
  riskFlagsReviewed    PaymentRiskFlag[]     @relation("RiskReviewer")
  statementsUploaded   StatementImport[]     @relation("StatementUploader")
  reconciliationsResolved PaymentReconciliation[] @relation("ReconciliationResolver")
  certificatesRevoked  CertificateRevocation[] @relation("CertificateRevoker")
  vocabularyItemsCreated VocabularyItem[]     @relation("VocabularyCreator")
  attendanceEventsActed AttendanceEvent[]     @relation("AttendanceActor")
  correctionsRequested  AttendanceCorrection[] @relation("CorrectionRequester")
  correctionsDecided    AttendanceCorrection[] @relation("CorrectionDecider")
  followUpAssigned      FollowUpTask[]         @relation("FollowUpAssignee")
  followUpCreated       FollowUpTask[]         @relation("FollowUpCreator")
  recordingsUploaded    ClassRecording[]       @relation("RecordingUploader")

  @@map("users")
}

model StudentProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  firstName             String    @map("first_name")
  lastName              String    @map("last_name")
  country               String?
  city                  String?
  timezone              String?
  currentBand           Decimal?  @map("current_band") @db.Decimal(3, 1)
  targetBand            Decimal?  @map("target_band") @db.Decimal(3, 1)
  ieltsExamDate         DateTime? @map("ielts_exam_date") @db.Date
  academicOrGeneral     String?   @map("academic_or_general")
  preferredLearningMode String?   @map("preferred_learning_mode")
  ieltsHistory          String?   @map("ielts_history")
  ieltsOverall          Decimal?  @map("ielts_overall") @db.Decimal(3, 1)
  ieltsListening        Decimal?  @map("ielts_listening") @db.Decimal(3, 1)
  ieltsReading          Decimal?  @map("ielts_reading") @db.Decimal(3, 1)
  ieltsWriting          Decimal?  @map("ielts_writing") @db.Decimal(3, 1)
  ieltsSpeaking         Decimal?  @map("ielts_speaking") @db.Decimal(3, 1)
  ieltsTestDate         DateTime? @map("ielts_test_date") @db.Date
  ieltsAttempts         Int?      @map("ielts_attempts")
  fatherName            String?   @map("father_name")
  dateOfBirth           DateTime? @map("date_of_birth") @db.Date
  gender                String?
  notes                 String?
  targetListening Decimal? @map("target_listening") @db.Decimal(3, 1)
  targetReading   Decimal? @map("target_reading")   @db.Decimal(3, 1)
  targetWriting   Decimal? @map("target_writing")   @db.Decimal(3, 1)
  targetSpeaking  Decimal? @map("target_speaking")  @db.Decimal(3, 1)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user         User                   @relation(fields: [userId], references: [id])
  enrollments  Enrollment[]
  orders       Order[]
  progress     ContentProgress[]
  attempts     AssessmentAttempt[]
  submissions  Submission[]
  attendance   Attendance[]
  redemptions  CouponRedemption[]
  timeline     StudentTimelineEvent[]
  certificates Certificate[]
  referralCode         ReferralCode?
  referralsGiven       Referral[]            @relation("ReferrerStudent")
  referralReceived     Referral?             @relation("ReferredStudent")
  creditLedger         AccountCreditLedger[]
  generatedAssessments Assessment[]          @relation("PersonalAssessment")
  attendanceEvents     AttendanceEvent[]
  attendanceCorrections AttendanceCorrection[]
  attendanceWarnings AttendanceWarning[]
  engagement           StudentEngagement?
  engagementHistory    EngagementStatusHistory[]
  followUpTasks        FollowUpTask[]
  recordingViews       RecordingView[]
  snapshots            StudentSnapshot[]
  leaderboardOptOut    Boolean   @default(false) @map("leaderboard_opt_out")
  studyPlans           StudyPlan[]
  studyPlanTasks       StudyPlanTask[]
  studentVocabulary    StudentVocabulary[]
  grammarObservations  GrammarObservation[]
  writingResponses     WritingResponse[]
  speakingAttempts     SpeakingAttempt[]
  speakingResponses    SpeakingResponse[]
  examAttempts         ExamAttempt[]

  @@map("student_profiles")
}

model MentorProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  displayName     String   @map("display_name")
  bio             String?
  specializations String[]
  status          String   @default("ACTIVE")
  applicationId   String?  @unique @map("application_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  user        User                @relation(fields: [userId], references: [id])
  application TeacherApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  batches     BatchMentor[]
  sessions    LiveSession[]
  gradingDrafts GradingDraft[]

  @@map("mentor_profiles")
}

model TeacherApplication {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status             String    @default("PENDING")
  fullName           String    @map("full_name")
  fatherName         String?   @map("father_name")
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  gender             String?
  nationality        String?
  idNumber           String?   @map("id_number")
  maritalStatus      String?   @map("marital_status")
  phone              String
  email              String
  currentAddress     String?   @map("current_address")
  permanentAddress   String?   @map("permanent_address")
  city               String?
  emergencyName      String?   @map("emergency_name")
  emergencyRelation  String?   @map("emergency_relation")
  emergencyPhone     String?   @map("emergency_phone")
  subjects           String[] @default([])
  ieltsModules       String[]  @map("ielts_modules") @default([])
  teachingYears      Decimal?  @map("teaching_years") @db.Decimal(4, 1)
  ieltsYears         Decimal?  @map("ielts_years") @db.Decimal(4, 1)
  otherEnglishYears  Decimal?  @map("other_english_years") @db.Decimal(4, 1)
  levelsTaught       String?   @map("levels_taught")
  onlineExperience   Boolean?  @map("online_experience")
  inPersonExperience Boolean?  @map("in_person_experience")
  preferredMode      String?   @map("preferred_mode")
  languages          String[] @default([])
  availableDays      String[]  @map("available_days") @default([])
  availableTime      String?   @map("available_time")
  employmentType     String?   @map("employment_type")
  workingHours       String?   @map("working_hours")
  joiningDate        DateTime? @map("joining_date") @db.Date
  noticePeriod       String?   @map("notice_period")
  expectedSalary     Decimal?  @map("expected_salary") @db.Decimal(12, 2)
  expectedHourlyRate Decimal?  @map("expected_hourly_rate") @db.Decimal(12, 2)
  skills             String[] @default([])
  achievements       String?
  publications       String?
  memberships        String?
  personalStatement  String?   @map("personal_statement")
  notes              String?
  internalNotes      String?   @map("internal_notes")
  rejectionReason    String?   @map("rejection_reason")
  reviewedBy         String?   @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime? @map("reviewed_at")
  submittedAt        DateTime  @default(now()) @map("submitted_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  mentor         MentorProfile?
  educations     TeacherEducation[]
  experiences    TeacherExperience[]
  certifications TeacherCertification[]
  references     TeacherReference[]
  documents      TeacherDocument[]

  @@index([status, submittedAt])
  @@map("teacher_applications")
}

model TeacherEducation {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String  @map("application_id") @db.Uuid
  degree        String
  field         String?
  institution   String
  country       String?
  startYear     Int?    @map("start_year")
  endYear       Int?    @map("end_year")
  grade         String?

  application TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([applicationId])
  @@map("teacher_educations")
}

model TeacherExperience {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId    String    @map("application_id") @db.Uuid
  organization     String
  jobTitle         String    @map("job_title")
  employmentType   String?   @map("employment_type")
  startDate        DateTime? @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  current          Boolean   @default(false)
  responsibilities String?
  reasonForLeaving String?   @map("reason_for_leaving")

  application TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([applicationId])
  @@map("teacher_experiences")
}

model TeacherCertification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  name          String
  issuer        String?
  issuedAt      DateTime? @map("issued_at") @db.Date
  expiresAt     DateTime? @map("expires_at") @db.Date

  application TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([applicationId])
  @@map("teacher_certifications")
}

model TeacherReference {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String  @map("application_id") @db.Uuid
  name          String
  organization  String?
  position      String?
  relationship  String?
  phone         String?
  email         String?

  application TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([applicationId])
  @@map("teacher_references")
}

model TeacherDocument {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  kind          String
  label         String?
  fileKey       String   @map("file_key")
  fileMime      String   @map("file_mime")
  createdAt     DateTime @default(now()) @map("created_at")

  application TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([applicationId])
  @@map("teacher_documents")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(true) @map("is_system")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id])

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model MfaSecret {
  userId      String    @id @map("user_id") @db.Uuid
  secretEnc   String    @map("secret_enc")
  confirmedAt DateTime? @map("confirmed_at")
  user        User      @relation(fields: [userId], references: [id])

  @@map("mfa_secrets")
}

// ───────── Academic ─────────
model Course {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique
  title             String
  slug              String       @unique
  description       String?
  courseType        String       @default("BAND_BASED") @map("course_type")
  durationWeeks     Int?         @map("duration_weeks")
  defaultAccessDays Int          @default(180) @map("default_access_days")
  price             Decimal      @db.Decimal(12, 2)
  currency          String       @default("PKR")
  status            CourseStatus @default(DRAFT)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  versions    CourseVersion[]
  batches     Batch[]
  enrollments Enrollment[]

  @@map("courses")
}

model CourseVersion {
  id            String        @id @default(uuid()) @db.Uuid
  courseId      String        @map("course_id") @db.Uuid
  versionNumber Int           @map("version_number")
  status        VersionStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  revision      Int           @default(1)

  course      Course          @relation(fields: [courseId], references: [id])
  sections    CourseSection[]
  batches     Batch[]
  enrollments Enrollment[]
  assessments Assessment[]

  @@unique([courseId, versionNumber])
  @@map("course_versions")
}

model CourseSection {
  id              String        @id @default(uuid()) @db.Uuid
  courseVersionId String        @map("course_version_id") @db.Uuid
  parentSectionId String?       @map("parent_section_id") @db.Uuid
  title           String
  description     String?
  sequence        Int           @default(0)
  status          ContentStatus @default(PUBLISHED)

  version  CourseVersion   @relation(fields: [courseVersionId], references: [id])
  parent   CourseSection?  @relation("SectionTree", fields: [parentSectionId], references: [id])
  children CourseSection[] @relation("SectionTree")
  items    ContentItem[]

  @@index([courseVersionId, parentSectionId, sequence])
  @@map("course_sections")
}

model ContentItem {
  id               String        @id @default(uuid()) @db.Uuid
  sectionId        String        @map("section_id") @db.Uuid
  title            String
  contentType      ContentType   @map("content_type")
  sequence         Int           @default(0)
  isRequired       Boolean       @default(true) @map("is_required")
  estimatedMinutes Int?          @map("estimated_minutes")
  releaseType      ReleaseType   @default(IMMEDIATE) @map("release_type")
  releaseValue     Json?         @map("release_value")
  status           ContentStatus @default(PUBLISHED)
  metadataJson     Json?         @map("metadata_json")
  createdAt        DateTime      @default(now()) @map("created_at")

  section     CourseSection     @relation(fields: [sectionId], references: [id])
  progress    ContentProgress[]
  assignment  Assignment?

  @@index([sectionId, sequence])
  @@map("content_items")
}

model Batch {
  id                String       @id @default(uuid()) @db.Uuid
  courseId          String       @map("course_id") @db.Uuid
  courseVersionId   String       @map("course_version_id") @db.Uuid
  name              String
  startAt           DateTime     @map("start_at")
  endAt             DateTime?    @map("end_at")
  timezone          String       @default("Asia/Karachi")
  days              String[]     @default([])
  classTime         String?      @map("class_time")
  description       String?
  deliveryMode      DeliveryMode @default(ONLINE) @map("delivery_mode")
  enrollmentOpenAt  DateTime?    @map("enrollment_open_at")
  enrollmentCloseAt DateTime?    @map("enrollment_close_at")
  status            BatchStatus  @default(DRAFT)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  course       Course            @relation(fields: [courseId], references: [id])
  version      CourseVersion     @relation(fields: [courseVersionId], references: [id])
  mentors      BatchMentor[]
  enrollments  Enrollment[]
  sessions     LiveSession[]
  orderItems   OrderItem[]
  recordings   ClassRecording[]
  leaderboards LeaderboardSnapshot[]
  healthSnapshot BatchHealthSnapshot?

  @@map("batches")
}

model BatchMentor {
  batchId    String     @map("batch_id") @db.Uuid
  mentorId   String     @map("mentor_id") @db.Uuid
  mentorRole MentorRole @default(MAIN) @map("mentor_role")
  assignedAt DateTime   @default(now()) @map("assigned_at")

  batch  Batch         @relation(fields: [batchId], references: [id])
  mentor MentorProfile @relation(fields: [mentorId], references: [id])

  @@id([batchId, mentorId, mentorRole])
  @@index([mentorId])
  @@map("batch_mentors")
}

model ContentProgress {
  id               String         @id @default(uuid()) @db.Uuid
  enrollmentId     String         @map("enrollment_id") @db.Uuid
  studentId        String         @map("student_id") @db.Uuid
  contentItemId    String         @map("content_item_id") @db.Uuid
  status           ProgressStatus @default(NOT_STARTED)
  progressPercent  Int            @default(0) @map("progress_percent")
  timeSpentSeconds Int            @default(0) @map("time_spent_seconds")
  lastPosition     Int?           @map("last_position")
  startedAt        DateTime?      @map("started_at")
  completedAt      DateTime?      @map("completed_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  enrollment  Enrollment     @relation(fields: [enrollmentId], references: [id])
  student     StudentProfile @relation(fields: [studentId], references: [id])
  contentItem ContentItem    @relation(fields: [contentItemId], references: [id])

  @@unique([studentId, enrollmentId, contentItemId])
  @@index([contentItemId, status])
  @@map("content_progress")
}

// ───────── Commerce ─────────
model Enrollment {
  id              String           @id @default(uuid()) @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  courseId        String           @map("course_id") @db.Uuid
  courseVersionId String           @map("course_version_id") @db.Uuid
  batchId         String           @map("batch_id") @db.Uuid
  orderItemId     String?          @unique @map("order_item_id") @db.Uuid
  status          EnrollmentStatus @default(PENDING_PAYMENT)
  source          EnrollmentSource @default(ONLINE_PURCHASE)
  enrolledAt      DateTime?        @map("enrolled_at")
  accessStartsAt  DateTime?        @map("access_starts_at")
  accessEndsAt    DateTime?        @map("access_ends_at")
  completedAt     DateTime?        @map("completed_at")
  progressPercent Decimal          @default(0) @map("progress_percent") @db.Decimal(5, 2)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  student   StudentProfile        @relation(fields: [studentId], references: [id])
  course    Course                @relation(fields: [courseId], references: [id])
  version   CourseVersion         @relation(fields: [courseVersionId], references: [id])
  batch     Batch                 @relation(fields: [batchId], references: [id])
  orderItem OrderItem?            @relation(fields: [orderItemId], references: [id])
  progress  ContentProgress[]
  transfers EnrollmentTransfer[]
  attempts  AssessmentAttempt[]
  submissions Submission[]
  certificate Certificate?

  @@index([studentId, status])
  @@index([batchId, status])
  @@index([status, enrolledAt])
  @@map("enrollments")
}

model EnrollmentTransfer {
  id            String   @id @default(uuid()) @db.Uuid
  enrollmentId  String   @map("enrollment_id") @db.Uuid
  fromBatchId   String   @map("from_batch_id") @db.Uuid
  toBatchId     String   @map("to_batch_id") @db.Uuid
  reason        String
  approvedBy    String   @map("approved_by") @db.Uuid
  transferredAt DateTime @default(now()) @map("transferred_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@map("enrollment_transfers")
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  reference String      @unique
  studentId String      @map("student_id") @db.Uuid
  subtotal  Decimal     @db.Decimal(12, 2)
  discount  Decimal     @default(0) @db.Decimal(12, 2)
  tax       Decimal     @default(0) @db.Decimal(12, 2)
  total     Decimal     @db.Decimal(12, 2)
  currency  String
  status    OrderStatus @default(AWAITING_PAYMENT)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  student      StudentProfile     @relation(fields: [studentId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  redemptions  CouponRedemption[]
  referrals    Referral[]

  @@index([studentId, status])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  courseId      String  @map("course_id") @db.Uuid
  batchId       String  @map("batch_id") @db.Uuid
  originalPrice Decimal @map("original_price") @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  finalPrice    Decimal @map("final_price") @db.Decimal(12, 2)

  order      Order       @relation(fields: [orderId], references: [id])
  batch      Batch       @relation(fields: [batchId], references: [id])
  enrollment Enrollment?

  @@map("order_items")
}

model Payment {
  id         String          @id @default(uuid()) @db.Uuid
  orderId    String          @map("order_id") @db.Uuid
  provider   PaymentProvider @default(BANK_TRANSFER)
  reference  String?
  amount     Decimal         @db.Decimal(12, 2)
  currency   String
  status     PaymentStatus   @default(CREATED)
  paidAt     DateTime?       @map("paid_at")
  verifiedBy String?         @map("verified_by") @db.Uuid
  verifiedAt DateTime?       @map("verified_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  order   Order          @relation(fields: [orderId], references: [id])
  proofs  PaymentProof[]
  events  PaymentEvent[]
  refunds Refund[]
  riskFlags PaymentRiskFlag[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

model PaymentProof {
  id               String      @id @default(uuid()) @db.Uuid
  paymentId        String      @map("payment_id") @db.Uuid
  senderName       String      @map("sender_name")
  paymentMethod    String      @default("BANK_TRANSFER") @map("payment_method")
  senderBank       String?     @map("sender_bank")
  bankTxnReference String      @map("bank_txn_reference")
  claimedAmount    Decimal     @map("claimed_amount") @db.Decimal(12, 2)
  transferDate     DateTime    @map("transfer_date") @db.Date
  fileKey          String      @map("file_key")
  fileMime         String      @map("file_mime")
  status           ProofStatus @default(SUBMITTED)
  flags            String[]
  rejectionReason  String?     @map("rejection_reason")
  allowResubmit    Boolean     @default(true) @map("allow_resubmit")
  fileSha256       String?     @map("file_sha256")
  riskFlags        PaymentRiskFlag[]
  reconciliation   PaymentReconciliation?
  reviewedBy       String?     @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?   @map("reviewed_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([status, createdAt])
  @@map("payment_proofs")
}

model PaymentEvent {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  type      String
  payload   Json?
  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("payment_events")
}

model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @map("payment_id") @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  reason            String
  status            RefundStatus @default(REQUESTED)
  providerReference String?      @map("provider_reference")
  requestedBy       String       @map("requested_by") @db.Uuid
  approvedBy        String?      @map("approved_by") @db.Uuid
  processedAt       DateTime?    @map("processed_at")
  decisionNote      String?      @map("decision_note")
  createdAt         DateTime     @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model Coupon {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique
  status            String       @default("ACTIVE")
  name              String?
  description       String?
  createdById       String?      @map("created_by") @db.Uuid
  discountType      DiscountType @map("discount_type")
  value             Decimal      @db.Decimal(12, 2)
  courseId          String?      @map("course_id") @db.Uuid
  batchId           String?      @map("batch_id") @db.Uuid
  userId            String?      @map("user_id") @db.Uuid
  firstPurchaseOnly Boolean      @default(false) @map("first_purchase_only")
  maxRedemptions    Int?         @map("max_redemptions")
  perUserLimit      Int          @default(1) @map("per_user_limit")
  redeemedCount     Int          @default(0) @map("redeemed_count")
  minPurchase       Decimal?     @map("min_purchase") @db.Decimal(12, 2)
  startsAt          DateTime?    @map("starts_at")
  expiresAt         DateTime?    @map("expires_at")
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now()) @map("created_at")

  redemptions CouponRedemption[]
  createdBy   User?              @relation("CouponCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rewardedReferrals Referral[]   @relation("RewardCoupon")

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  status    String   @default("RESERVED")
  discountAmount Decimal? @map("discount_amount") @db.Decimal(12, 2)
  codeSnapshot   String?  @map("code_snapshot")
  createdAt DateTime @default(now()) @map("created_at")

  coupon  Coupon         @relation(fields: [couponId], references: [id])
  student StudentProfile @relation(fields: [studentId], references: [id])
  order   Order          @relation(fields: [orderId], references: [id])

  @@map("coupon_redemptions")
}

// ───────── Assessment (schema only in pass 1) ─────────
model Assessment {
  id              String         @id @default(uuid()) @db.Uuid
  courseVersionId String?        @map("course_version_id") @db.Uuid
  type            AssessmentType
  title           String
  maxAttempts     Int?           @map("max_attempts")
  timeLimitMin    Int?           @map("time_limit_min")
  skill           String?
  passPercent     Int            @default(0) @map("pass_percent")
  showAnswers     Boolean        @default(true) @map("show_answers")
  origin                String         @default("MANUAL")
  generatedForStudentId String?        @map("generated_for_student_id") @db.Uuid
  libraryVisible        Boolean        @default(false) @map("library_visible")
  createdAt       DateTime       @default(now()) @map("created_at")

  generatedFor  StudentProfile?     @relation("PersonalAssessment", fields: [generatedForStudentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseVersion CourseVersion?        @relation(fields: [courseVersionId], references: [id])
  versions      AssessmentVersion[]
  attempts      AssessmentAttempt[]
  simListeningExams ExamAttempt[] @relation("SimListening")
  simReadingExams   ExamAttempt[] @relation("SimReading")

  @@map("assessments")
}

model AssessmentVersion {
  id           String    @id @default(uuid()) @db.Uuid
  assessmentId String    @map("assessment_id") @db.Uuid
  version      Int
  publishedAt  DateTime? @map("published_at")

  assessment Assessment          @relation(fields: [assessmentId], references: [id])
  sections   AssessmentSection[]
  attempts   AssessmentAttempt[]

  @@unique([assessmentId, version])
  @@map("assessment_versions")
}

model AssessmentSection {
  id                  String @id @default(uuid()) @db.Uuid
  assessmentVersionId String @map("assessment_version_id") @db.Uuid
  title               String
  sequence            Int    @default(0)
  content             Json?

  version   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  questions Question[]

  @@map("assessment_sections")
}

model Question {
  id           String    @id @default(uuid()) @db.Uuid
  sectionId    String?   @map("section_id") @db.Uuid
  questionType String    @map("question_type")
  sequence     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")
  questionSetId    String?   @map("question_set_id") @db.Uuid
  ieltsType        String?   @map("ielts_type")
  sourceQuestionId String?   @map("source_question_id") @db.Uuid

  section        AssessmentSection? @relation(fields: [sectionId], references: [id])
  questionSet    QuestionSet?       @relation(fields: [questionSetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceQuestion Question?          @relation("SourceQuestion", fields: [sourceQuestionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  copies         Question[]         @relation("SourceQuestion")
  writingResponses WritingResponse[]
  speakingResponses SpeakingResponse[]
  versions QuestionVersion[]

  @@index([questionSetId], map: "questions_set_idx")

  @@map("questions")
}

model QuestionVersion {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  version    Int
  prompt     Json
  answerKey  Json?   @map("answer_key")
  marks      Decimal @default(1) @db.Decimal(6, 2)

  question Question         @relation(fields: [questionId], references: [id])
  options  QuestionOption[]
  answers  AttemptAnswer[]

  @@unique([questionId, version])
  @@map("question_versions")
}

model QuestionOption {
  id                String  @id @default(uuid()) @db.Uuid
  questionVersionId String  @map("question_version_id") @db.Uuid
  label             String
  isCorrect         Boolean @default(false) @map("is_correct")
  sequence          Int     @default(0)

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id])

  @@map("question_options")
}

model AssessmentAttempt {
  id                  String        @id @default(uuid()) @db.Uuid
  assessmentId        String        @map("assessment_id") @db.Uuid
  assessmentVersionId String        @map("assessment_version_id") @db.Uuid
  studentId           String        @map("student_id") @db.Uuid
  enrollmentId        String?       @map("enrollment_id") @db.Uuid
  attemptNumber       Int           @map("attempt_number")
  startedAt           DateTime?     @map("started_at")
  submittedAt         DateTime?     @map("submitted_at")
  status              AttemptStatus @default(NOT_STARTED)
  rawScore            Decimal?      @map("raw_score") @db.Decimal(6, 2)
  maxScore            Decimal?      @map("max_score") @db.Decimal(6, 2)
  bandScore           Decimal?      @map("band_score") @db.Decimal(3, 1)
  revision            Int           @default(0)
  expiresAt           DateTime?     @map("expires_at")
  percent             Decimal?      @db.Decimal(5, 2)

  assessment   Assessment        @relation(fields: [assessmentId], references: [id])
  version      AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  student      StudentProfile    @relation(fields: [studentId], references: [id])
  enrollment   Enrollment?       @relation(fields: [enrollmentId], references: [id])
  answers      AttemptAnswer[]
  rubricScores RubricScore[]
  simListeningExams ExamAttempt[] @relation("SimListeningAttempt")
  simReadingExams   ExamAttempt[] @relation("SimReadingAttempt")

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([studentId, status])
  @@index([submittedAt])
  @@map("assessment_attempts")
}

model AttemptAnswer {
  id                String   @id @default(uuid()) @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  questionVersionId String   @map("question_version_id") @db.Uuid
  answer            Json
  revision          Int      @default(0)
  isCorrect         Boolean? @map("is_correct")
  updatedAt         DateTime @updatedAt @map("updated_at")

  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id])
  questionVersion QuestionVersion   @relation(fields: [questionVersionId], references: [id])

  @@unique([attemptId, questionVersionId])
  @@index([questionVersionId, isCorrect])
  @@map("attempt_answers")
}

model Rubric {
  id       String            @id @default(uuid()) @db.Uuid
  name     String
  skill    String
  version  Int               @default(1)
  criteria RubricCriterion[]
  assignments Assignment[]

  @@map("rubrics")
}

model RubricCriterion {
  id       String @id @default(uuid()) @db.Uuid
  rubricId String @map("rubric_id") @db.Uuid
  name     String
  sequence Int    @default(0)

  rubric Rubric        @relation(fields: [rubricId], references: [id])
  scores RubricScore[]

  @@map("rubric_criteria")
}

model RubricScore {
  id           String   @id @default(uuid()) @db.Uuid
  attemptId    String?  @map("attempt_id") @db.Uuid
  submissionId String?  @map("submission_id") @db.Uuid
  feedbackId   String?  @map("feedback_id") @db.Uuid
  criterionId  String   @map("criterion_id") @db.Uuid
  score        Decimal  @db.Decimal(3, 1)
  comment      String?
  gradedBy     String   @map("graded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  attempt    AssessmentAttempt? @relation(fields: [attemptId], references: [id])
  submission Submission?        @relation(fields: [submissionId], references: [id])
  feedback   SubmissionFeedback? @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  criterion  RubricCriterion    @relation(fields: [criterionId], references: [id])

  @@map("rubric_scores")
}

model BandConversionTable {
  id            String   @id @default(uuid()) @db.Uuid
  testType      String   @map("test_type")
  rawMin        Int      @map("raw_min")
  rawMax        Int      @map("raw_max")
  band          Decimal  @db.Decimal(3, 1)
  version       Int      @default(1)
  effectiveDate DateTime @map("effective_date") @db.Date

  // Pinned to the index created in SQL (20260930000000_assessment_engine).
  @@index([testType, version, rawMin], map: "band_conversion_lookup_idx")
  @@map("band_conversion_tables")
}

model Assignment {
  id            String    @id @default(uuid()) @db.Uuid
  contentItemId String    @unique @map("content_item_id") @db.Uuid
  instructions  String?
  dueAt         DateTime? @map("due_at")
  skill         String    @default("WRITING")
  rubricId      String?   @map("rubric_id") @db.Uuid
  minWords      Int?      @map("min_words")

  contentItem ContentItem  @relation(fields: [contentItemId], references: [id])
  rubric      Rubric?      @relation(fields: [rubricId], references: [id])
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  body         String?
  fileKey      String?  @map("file_key")
  status       String   @default("SUBMITTED")
  revision     Int      @default(1)
  submittedAt  DateTime @default(now()) @map("submitted_at")
  enrollmentId String?  @map("enrollment_id") @db.Uuid
  wordCount    Int?     @map("word_count")
  fileMime     String?  @map("file_mime")
  late         Boolean  @default(false)
  gradedAt     DateTime? @map("graded_at")
  finalBand    Decimal? @map("final_band") @db.Decimal(3, 1)

  assignment   Assignment           @relation(fields: [assignmentId], references: [id])
  student      StudentProfile       @relation(fields: [studentId], references: [id])
  enrollment   Enrollment?          @relation(fields: [enrollmentId], references: [id])
  feedback     SubmissionFeedback[]
  rubricScores RubricScore[]
  writingEvaluations WritingEvaluation[]
  speakingEvaluations SpeakingEvaluation[]
  gradingDrafts GradingDraft[]

  // Names pinned to the indexes already created in SQL (20260930000100_grading) so Prisma keeps them.
  @@index([status, submittedAt], map: "submissions_status_submitted_at_idx")
  @@index([studentId], map: "submissions_student_id_idx")
  @@index([assignmentId, status])
  @@index([gradedAt])
  @@map("submissions")
}

model SubmissionFeedback {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  mentorId     String   @map("mentor_id") @db.Uuid
  comment      String?
  finalBand    Decimal? @map("final_band") @db.Decimal(3, 1)
  createdAt    DateTime @default(now()) @map("created_at")

  submission   Submission    @relation(fields: [submissionId], references: [id])
  rubricScores RubricScore[]

  @@index([mentorId, createdAt])
  @@map("submission_feedback")
}

// ───────── Live ─────────
model LiveSession {
  id           String   @id @default(uuid()) @db.Uuid
  batchId      String   @map("batch_id") @db.Uuid
  mentorId     String?  @map("mentor_id") @db.Uuid
  topic        String
  startsAt     DateTime @map("starts_at")
  endsAt       DateTime @map("ends_at")
  provider     String?
  meetingUrl   String?  @map("meeting_url")
  recordingUrl String?  @map("recording_url")
  title        String?
  status       String   @default("SCHEDULED")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String? @map("cancel_reason")
  startedAt    DateTime? @map("started_at")
  endedAt      DateTime? @map("ended_at")

  batch      Batch          @relation(fields: [batchId], references: [id])
  mentor     MentorProfile? @relation(fields: [mentorId], references: [id])
  attendance Attendance[]
  attendanceEvents AttendanceEvent[]
  attendanceCorrections AttendanceCorrection[]
  recordings ClassRecording[]

  @@index([batchId, startsAt])
  @@index([mentorId, startsAt])
  @@map("live_sessions")
}

model Attendance {
  id              String            @id @default(uuid()) @db.Uuid
  sessionId       String            @map("session_id") @db.Uuid
  studentId       String            @map("student_id") @db.Uuid
  status          SessionAttendance
  joinedAt        DateTime?         @map("joined_at")
  leftAt          DateTime?         @map("left_at")
  minutesAttended Int?              @map("minutes_attended")
  note        String?
  markedAt    DateTime? @map("marked_at")
  markedBy        String?           @map("marked_by") @db.Uuid

  session LiveSession    @relation(fields: [sessionId], references: [id])
  student StudentProfile @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId, status])
  @@map("attendance")
}

// ───────── Ops ─────────
model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel @default(IN_APP)
  type      String
  title     String
  body      String?
  readAt     DateTime?           @map("read_at")
  dedupeKey  String?             @map("dedupe_key")
  entityType String?             @map("entity_type")
  entityId   String?             @map("entity_id") @db.Uuid
  link       String?
  createdAt  DateTime            @default(now()) @map("created_at")

  user       User                @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  userId  String              @map("user_id") @db.Uuid
  type    String
  channel NotificationChannel
  enabled Boolean             @default(true)

  @@id([userId, type, channel])
  @@map("notification_preferences")
}

model SupportTicket {
  id          String         @id @default(uuid()) @db.Uuid
  studentId   String         @map("student_id") @db.Uuid
  category    TicketCategory
  priority    String         @default("NORMAL")
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  assignedTo  String?        @map("assigned_to") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  resolvedAt  DateTime?      @map("resolved_at")
  slaDueAt        DateTime?  @map("sla_due_at")
  firstResponseAt DateTime?  @map("first_response_at")

  user     User            @relation(fields: [studentId], references: [id])
  messages TicketMessage[]

  @@index([status, createdAt])
  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model Certificate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId String   @unique @map("enrollment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  code         String   @unique
  studentName  String   @map("student_name")
  courseTitle  String   @map("course_title")
  issuedAt     DateTime @default(now()) @map("issued_at")
  certificateNumber String? @unique(map: "certificates_number_unique") @map("certificate_number")
  batchName    String?  @map("batch_name")
  revocation   CertificateRevocation?

  enrollment Enrollment     @relation(fields: [enrollmentId], references: [id])
  student    StudentProfile @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@map("certificates")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ipAddress  String?  @map("ip_address")
