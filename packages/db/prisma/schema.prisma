}

model ClassRecording {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  batchId      String   @map("batch_id") @db.Uuid
  storageKey   String?  @unique @map("storage_key")
  externalUrl  String?  @map("external_url")
  durationSec  Int?     @map("duration_sec")
  sizeBytes    BigInt?  @map("size_bytes")
  mime         String?
  status       String   @default("READY")
  availability String   @default("BATCH")
  uploadedById String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  session    LiveSession    @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batch      Batch          @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedBy User           @relation("RecordingUploader", fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  views      RecordingView[]

  @@index([batchId, createdAt], map: "class_recordings_batch_idx")
  @@map("class_recordings")
}

model RecordingView {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordingId String    @map("recording_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  positionSec Int       @default(0) @map("position_sec")
  completedAt DateTime? @map("completed_at")
  startedAt   DateTime  @default(now()) @map("started_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  recording ClassRecording   @relation(fields: [recordingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([recordingId, studentId], map: "recording_views_unique")
  @@map("recording_views")
}

model LeaderboardSnapshot {
