  periodType String   @map("period_type")
  periodKey  String   @map("period_key")
  entries    Json
  computedAt DateTime @default(now()) @map("computed_at")

  batch Batch @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([batchId, periodType, periodKey], map: "leaderboard_snapshots_unique")
  @@map("leaderboard_snapshots")
}

