{
  "name": "@ielts/db",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "node -e \"throw new Error('migrate dev is banned: no shadow database is configured, so it would create and drop a database on the production instance. Use npm run drift, a hand-written migration, then npm run migrate.')\"",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "reset": "dotenv -e ../../.env -- tsx prisma/reset.ts",
    "seed:demo": "dotenv -e ../../.env -- tsx prisma/seed-demo.ts",
    "drift": "dotenv -e ../../.env -- sh -c \"prisma migrate diff --from-url \\\"$DIRECT_URL\\\" --to-schema-datamodel prisma/schema.prisma --script\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0"
  }
}
