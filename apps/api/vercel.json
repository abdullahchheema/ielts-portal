{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build:packages && npm run build -w @ielts/api",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "includeFiles": "{dist/**,../../node_modules/.prisma/**,../../node_modules/@prisma/client/**,../../packages/*/dist/**}", "maxDuration": 30 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }],
  "crons": [{ "path": "/internal/cron", "schedule": "0 3 * * *" }]
}
